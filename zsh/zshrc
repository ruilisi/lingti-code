export ZSH="$HOME/.oh-my-zsh"
export VIRTUAL_ENV_DISABLE_PROMPT=1

ZSH_THEME="agnoster"
DEFAULT_USER="$USER"

plugins=(
  git
  macos
  ssh-agent
  zsh-syntax-highlighting
  zsh-history-substring-search
)

if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  echo "lingti: oh-my-zsh not installed at $ZSH — run \`cd ~/.lingti && rake install_ohmyzsh\` to fix."
fi

# Load lingti configs
for config_file ($HOME/.lingti/zsh/*.zsh) source $config_file

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# bun completions
[ -s "~/.bun/_bun" ] && source "~/.bun/_bun"
# OpenClaw Completion
[ -f "$HOME/.openclaw/completions/openclaw.zsh" ] && source "$HOME/.openclaw/completions/openclaw.zsh"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

# Lingti bin must come LAST so its shims (vim → nvim, etc.) win over
# everything else prepended above.
export PATH="$HOME/.lingti/bin:$PATH"

# Dedupe PATH — zprofile marked `path` unique via `typeset -gU`, but that
# only enforces uniqueness on array assignments (`path=(...)`), not on
# `export PATH=x:$PATH` used throughout downstream configs. Re-syncing the
# array here collapses all duplicates while preserving first occurrence.
typeset -aU path
path=($path)
